<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; Compose draws the Feibai interface. -->
    <style name="Theme.HaikuWall" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.HaikuWall.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">260</item>
        <item name="postSplashScreenTheme">@style/Theme.HaikuWall</item>
    </style>
</resources>
